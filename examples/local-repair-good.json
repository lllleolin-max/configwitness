{
  "version": 1,
  "description": "Synthetic case where both local baselines must actually repair and match the fleet optimum",
  "fields": {"replicas": {"type": "int"}},
  "layers": [{"id": "a", "parents": [], "overrides": {"replicas": 0}}, {"id": "b", "parents": [], "overrides": {"replicas": 0}}],
  "environments": [{"id": "a", "layer": "a"}, {"id": "b", "layer": "b"}],
  "constraints": [{"id": "local", "kind": "range", "envs": ["a", "b"], "field": "replicas", "min": 1, "max": 2}, {"id": "fleet-total", "kind": "sum", "envs": ["a", "b"], "field": "replicas", "max": 4}],
  "edits": [
    {"layer": "a", "field": "replicas", "options": [{"op": "set", "value": 1, "cost": 1}, {"op": "set", "value": 2, "cost": 2}]},
    {"layer": "b", "field": "replicas", "options": [{"op": "set", "value": 1, "cost": 1}, {"op": "set", "value": 2, "cost": 2}]}
  ],
  "protected": []
}
